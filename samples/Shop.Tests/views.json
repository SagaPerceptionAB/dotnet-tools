        {
          "id": "ui:/products/create",
          "route": "/products/create",
          "kind": "blazor",
          "source": "../ShopWeb/Components/Pages/ProductCreate.razor",
          "title": "Ny produkt",
          "heading": "Ny produkt",
          "parameters": [],
          "forms": [
            {
              "id": "Product",
              "model": "ProductInput",
              "submit": {
                "kind": "role",
                "value": "button",
                "name": "Spara produkt"
              },
              "fields": [
                {
                  "name": "Name",
                  "label": "Namn",
                  "type": "text",
                  "locator": {
                    "kind": "label",
                    "value": "Namn"
                  },
                  "rules": [
                    {
                      "kind": "required",
                      "message": "Namn måste fyllas i."
                    },
                    {
                      "kind": "min-length",
                      "value": "2",
                      "message": "Namnet ska vara mellan 2 och 50 tecken."
                    },
                    {
                      "kind": "max-length",
                      "value": "50",
                      "message": "Namnet ska vara mellan 2 och 50 tecken."
                    }
                  ],
                  "options": [],
                  "specField": "name"
                },
                {
                  "name": "Sku",
                  "label": "Artikelkod",
                  "type": "text",
                  "locator": {
                    "kind": "label",
                    "value": "Artikelkod"
                  },
                  "rules": [
                    {
                      "kind": "required",
                      "message": "Artikelkod måste fyllas i."
                    },
                    {
                      "kind": "pattern",
                      "value": "^[A-Z]{3}-[0-9]{4}$",
                      "message": "Artikelkoden ska se ut som ABC-1234."
                    }
                  ],
                  "options": [],
                  "specField": "sku"
                },
                {
                  "name": "Price",
                  "label": "Pris",
                  "type": "number",
                  "locator": {
                    "kind": "label",
                    "value": "Pris"
                  },
                  "rules": [
                    {
                      "kind": "min",
                      "value": "1",
                      "message": "Priset ska vara mellan 1 och 100000."
                    },
                    {
                      "kind": "max",
                      "value": "100000",
                      "message": "Priset ska vara mellan 1 och 100000."
                    }
                  ],
                  "options": [],
                  "specField": "price"
                }
              ],
              "submitsTo": {
                "method": "POST",
                "path": "/products"
              },
              "operationId": "createProduct"
            }
          ],
