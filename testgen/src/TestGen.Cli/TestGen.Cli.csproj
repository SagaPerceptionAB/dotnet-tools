<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TestGen.Core\TestGen.Core.csproj" />
    <ProjectReference Include="..\TestGen.Browser\TestGen.Browser.csproj" />
    <ProjectReference Include="..\TestGen.Excel\TestGen.Excel.csproj" />
    <ProjectReference Include="..\TestGen.Mock\TestGen.Mock.csproj" />
    <ProjectReference Include="..\TestGen.Views\TestGen.Views.csproj" />
    <!-- Systemkartan (testgen map, kartan i testgen web och vägen i testkorten). Beroendet går bara åt det här hållet:
         systemkartan vet inget om testgen. -->
    <ProjectReference Include="..\..\..\systemmap\src\SystemMap\SystemMap.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Direkt referens, så att Playwrights installationsskript (testgen init installerar Chromium) hamnar bredvid programmet. -->
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Playwright tar annars bara med node för datorn som bygger (Ubuntu i release.yml), och då kan verktyget inte installera
         Chromium på Windows. Windows och Linux x64 täcker utvecklardatorerna och CI; macOS saknas medvetet (paketets storlek).
         eng/check-packages.sh kontrollerar att båda finns. -->
    <PlaywrightPlatform>win;linux-x64</PlaywrightPlatform>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="SagaPerception.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\index.html" LogicalName="TestGen.Web.index.html" />
    <!-- Cytoscape.js och layouten fcose (MIT) ritar systemkartan. De ligger i systemkartan och följer med i programmet,
         så att sidan inte hämtar något utifrån. -->
    <None Include="..\..\..\systemmap\src\SystemMap\Web\lib\*.LICENSE.txt" Pack="true" PackagePath="\licenses\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Paketversionerna som testgen init skriver i testprojektet: samma som repot själv använder. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PackageVersion:Microsoft.NET.Test.Sdk</_Parameter1>
      <_Parameter2>@(PackageVersion->WithMetadataValue('Identity', 'Microsoft.NET.Test.Sdk')->'%(Version)')</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PackageVersion:NUnit</_Parameter1>
      <_Parameter2>@(PackageVersion->WithMetadataValue('Identity', 'NUnit')->'%(Version)')</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PackageVersion:NUnit3TestAdapter</_Parameter1>
      <_Parameter2>@(PackageVersion->WithMetadataValue('Identity', 'NUnit3TestAdapter')->'%(Version)')</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TestGen.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>testgen</AssemblyName>
    <RootNamespace>TestGen.Cli</RootNamespace>
    <!-- Installeras som dotnet-verktyg, se README (Installera). Paket-id:t är inte "testgen": det namnet används redan av ett annat verktyg på nuget.org. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>testgen</ToolCommandName>
    <IsPackable>true</IsPackable>
    <PackageId>SagaPerception.TestGen.Cli</PackageId>
    <Version>$(SagaPerceptionTestGenVersion)</Version>
    <Description>Testar ett API utifrån dess OpenAPI-spec (ingen AI vid körning, samma indata ger samma resultat).</Description>
    <PackageTags>testgen;openapi;testing;playwright;sagaperception;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Playwrights .ps1-skript följer med i verktyget (testgen init installerar Chromium med dem); NuGet varnar för skript utanför tools/. -->
    <NoWarn>$(NoWarn);NU5111</NoWarn>
  </PropertyGroup>

</Project>
