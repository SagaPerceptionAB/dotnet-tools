<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>SagaPerception.TestGen.Core</PackageId>
    <Version>$(SagaPerceptionTestGenVersion)</Version>
    <Description>Motorn i testgen: OpenAPI-spec, testdata, testfall, körning och rapporter. Används av SagaPerception.Testing.NUnit.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\shared\CommandLine\CommandLine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TestGen.Excel" />
    <InternalsVisibleTo Include="TestGen.Views" />
    <InternalsVisibleTo Include="TestGen.Views.Tests" />
    <InternalsVisibleTo Include="TestGen.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi.YamlReader" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

</Project>
